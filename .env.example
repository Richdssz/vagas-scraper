# Configurações de E-mail (Gmail, Outlook ou qualquer SMTP)
EMAIL_REMETENTE=seu.email@gmail.com
EMAIL_SENHA_APP=xxxx xxxx xxxx xxxx
EMAIL_DESTINATARIO=seu.email@gmail.com

# Servidor SMTP (Padrão: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Modo Simulação (true para testar sem enviar e-mails reais)
DRY_RUN=true
